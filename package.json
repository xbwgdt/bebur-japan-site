{
  "name": "bebur-japanese-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sanity"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm exec --yes --package=wrangler@4.115.0 -- wrangler pages dev",
    "sanity:dev": "npm --prefix sanity run dev",
    "sanity:build": "npm --prefix sanity run build",
    "sanity:typecheck": "npm --prefix sanity run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:static": "node scripts/audit-static-assets.mjs",
    "audit:dependencies": "npm audit --audit-level=low",
    "sanity:sync-home-hero": "node scripts/sync-home-hero-to-sanity.mjs",
    "deploy:cloudflare": "npm exec --yes --package=wrangler@4.115.0 -- wrangler pages deploy"
  },
  "dependencies": {
    "@sanity/client": "^7.26.0",
    "@tailwindcss/postcss": "^4.1.12",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.539.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@sanity/schema": "6.23.0",
    "@sanity/types": "6.23.0",
    "@sanity/validation": "6.23.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "image-size": "^2.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@oclif/core@4": {
      "minimatch": "11.0.8"
    }
  }
}
